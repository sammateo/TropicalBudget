@using Newtonsoft.Json
@using TropicalBudget.Utilities
@model Tuple<Guid, List<Transaction>>
@{
    ViewData["Title"] = "Insights";
    List<Transaction> transactions = Model.Item2;
    Guid budgetID = Model.Item1;

    string currentMonthString = TempData.ContainsKey("currentMonthString") ? (string)TempData["currentMonthString"] :
string.Empty;
    DateTime startDate = (DateTime)TempData["startDate"];
    string budgetName = TempData["BudgetName"].ToString();
    @* string AIInsights = TempData["AIInsights"].ToString(); *@
    int nextMonth = startDate.AddMonths(1).Month;
    int nextYear = startDate.AddMonths(1).Year;
    int previousMonth = startDate.AddMonths(-1).Month;
    int previousYear = startDate.AddMonths(-1).Year;

    Dictionary<string, string> newTransactionRouteData = new()
    {
        {"budgetID", budgetID.ToString()}
    };
    Dictionary<string, string> fullTransactionRouteData = new()
    {
        {"budgetID", budgetID.ToString()},
        {"year", startDate.Year.ToString()},
        {"month", startDate.Month.ToString()},
    };

    List<IGrouping<Guid, Transaction>> categoryGroupedExpenses = transactions.Where(transaction =>
transaction.TransactionType == TransactionUtility.TRANSACTION_TYPE_EXPENSE && transaction.CategoryID !=
Guid.Empty).GroupBy(transaction => transaction.CategoryID).ToList();
    List<IGrouping<Guid, Transaction>> categoryGroupedIncome = transactions.Where(transaction => transaction.TransactionType
== TransactionUtility.TRANSACTION_TYPE_INCOME && transaction.CategoryID != Guid.Empty).GroupBy(transaction =>
transaction.CategoryID).ToList();

    List<IGrouping<Guid, Transaction>> categoryGroupedAddToSavings = transactions.Where(transaction =>
    transaction.TransactionType == TransactionUtility.TRANSACTION_TYPE_EXPENSE && transaction.SavingsGoalID !=
    Guid.Empty).GroupBy(transaction => transaction.SavingsGoalID).ToList();
    List<IGrouping<Guid, Transaction>> categoryGroupedWithdrawFromSavings = transactions.Where(transaction =>
transaction.TransactionType == TransactionUtility.TRANSACTION_TYPE_INCOME && transaction.SavingsGoalID !=
Guid.Empty).GroupBy(transaction => transaction.SavingsGoalID).ToList();

    List<Transaction> incomeTransactions = transactions.Where(x => x.TransactionType ==
TransactionUtility.TRANSACTION_TYPE_INCOME).ToList();
    List<Transaction> expenseTransactions = transactions.Where(x => x.TransactionType ==
TransactionUtility.TRANSACTION_TYPE_EXPENSE).ToList();
    decimal incomeAmount = incomeTransactions.Sum(x => x.Amount);
    decimal expenseAmount = expenseTransactions.Sum(x => x.Amount);
    decimal balance = incomeAmount - expenseAmount;


    List<Transaction> expensesByCategory = new();
    List<Transaction> incomeByCategory = new();
    foreach (IGrouping<Guid, Transaction> categoryGroupedTransaction in categoryGroupedExpenses)
    {
        expensesByCategory.Add(new()
        {
            CategoryID = categoryGroupedTransaction.Key,
            Amount = categoryGroupedTransaction.Sum(tran => tran.Amount),
            CategoryName = categoryGroupedTransaction.First().CategoryName,
            CategoryColor = categoryGroupedTransaction.First().CategoryColor
        });
    }
    foreach (IGrouping<Guid, Transaction> categoryGroupedTransaction in categoryGroupedIncome)
    {
        incomeByCategory.Add(new()
        {
            CategoryID = categoryGroupedTransaction.Key,
            Amount = categoryGroupedTransaction.Sum(tran => tran.Amount),
            CategoryName = categoryGroupedTransaction.First().CategoryName,
            CategoryColor = categoryGroupedTransaction.First().CategoryColor
        });
    }

    //savings by category
    List<Transaction> addToSavingsByCategory = new();
    List<Transaction> withdrawFromSavingsByCategory = new();
    foreach (IGrouping<Guid, Transaction> categoryGroupedTransaction in categoryGroupedAddToSavings)
    {
        addToSavingsByCategory.Add(new()
        {
            SavingsGoalID = categoryGroupedTransaction.Key,
            Amount = categoryGroupedTransaction.Sum(tran => tran.Amount),
            SavingsGoalTitle = categoryGroupedTransaction.First().SavingsGoalTitle,
            SavingsGoalColor = categoryGroupedTransaction.First().SavingsGoalColor
        });
    }
    foreach (IGrouping<Guid, Transaction> categoryGroupedTransaction in categoryGroupedWithdrawFromSavings)
    {
        withdrawFromSavingsByCategory.Add(new()
        {
            SavingsGoalID = categoryGroupedTransaction.Key,
            Amount = categoryGroupedTransaction.Sum(tran => tran.Amount),
            SavingsGoalTitle = categoryGroupedTransaction.First().SavingsGoalTitle,
            SavingsGoalColor = categoryGroupedTransaction.First().SavingsGoalColor
        });
    }


    //transactions grouped by date
    List<IGrouping<DateOnly, Transaction>> dateGroupedTransactions = transactions.Where(transaction =>
transaction.TransactionType == TransactionUtility.TRANSACTION_TYPE_EXPENSE && transaction.CategoryID !=
Guid.Empty).GroupBy(transaction =>
DateOnly.FromDateTime(transaction.TransactionDate)).OrderBy(x => x.Key).ToList();
    List<Transaction> transactionsByDate = new();
    foreach (IGrouping<DateOnly, Transaction> dateGroupedTransaction in dateGroupedTransactions)
    {
        transactionsByDate.Add(new()
        {
            TransactionDate = dateGroupedTransaction.First().TransactionDate,
            Amount = dateGroupedTransaction.Sum(tran => tran.Amount),
        });
    }

    //savings contributions grouped by date
    List<IGrouping<DateOnly, Transaction>> dateGroupedSavingsContributions = transactions.Where(transaction =>
transaction.TransactionType == TransactionUtility.TRANSACTION_TYPE_EXPENSE && transaction.SavingsGoalID !=
Guid.Empty).GroupBy(transaction =>
DateOnly.FromDateTime(transaction.TransactionDate)).OrderBy(x => x.Key).ToList();
    List<Transaction> savingsContributionsByDate = new();
    foreach (IGrouping<DateOnly, Transaction> dateGroupedTransaction in dateGroupedSavingsContributions)
    {
        savingsContributionsByDate.Add(new()
        {
            TransactionDate = dateGroupedTransaction.First().TransactionDate,
            Amount = dateGroupedTransaction.Sum(tran => tran.Amount),
        });
        Console.WriteLine(savingsContributionsByDate.Last().TransactionDate);
        Console.WriteLine(savingsContributionsByDate.Last().Amount);
    }


}

<div class="text-center">
    <h2 class="fs-1">Insights: @budgetName</h2>
    <div class="d-flex justify-content-between align-items-center gap-2 p-1 my-2 rounded-pill">
        <div onclick="previousMonth()" style="cursor:pointer"
             class="btn-outline-primary border border-primary d-flex align-items-center py-1 px-4 rounded-pill">
            <i class="bi bi-chevron-left fs-4" style="cursor:pointer"></i>
            <span class="d-none d-sm-block">@(startDate.AddMonths(-1).ToString("MMMM, yyyy"))</span>
        </div>
        <div class="d-flex flex-column gap-2">
            <p class="fs-5 fw-bold m-0">@currentMonthString</p>
            <p class="fs-6 fw-normal m-0 text-uppercase">@(transactions.Count) transactions</p>
        </div>
        <div onclick="nextMonth()" style="cursor:pointer"
             class="bg-primary d-flex align-items-center text-white py-1 px-4 rounded-pill">
            <span class="d-none d-sm-block">@(startDate.AddMonths(1).ToString("MMMM, yyyy"))</span>
            <i class="bi bi-chevron-right fs-4"></i>
        </div>
    </div>
    <partial name="~/Views/Home/_SpendingListBanner.cshtml" model="transactions" />
</div>

@* Button row *@
<div class="d-flex flex-wrap justify-content-end align-items-center gap-2 my-3">
    <a class="text-decoration-none py-1 px-4 d-block rounded-pill d-flex gap-2 btn btn-outline-primary border border-primary"
       asp-controller="Insights" asp-action="Index" asp-all-route-data="newTransactionRouteData">
        <span>Today</span>
        <i class="bi bi-calendar-check"></i>
    </a>
    <a class="text-decoration-none py-1 px-4 d-block rounded-pill d-flex gap-2 btn btn-outline-success border border-success"
       asp-controller="Insights" asp-action="AI" asp-all-route-data="fullTransactionRouteData">
        <span>AI Insights</span>
        <i class="bi bi-stars"></i>
    </a>
    <a id="spendingListButton"
       class="text-decoration-none py-1 px-4 rounded-pill d-flex gap-2 btn-outline-secondary border border-secondary"
       asp-controller="Transaction" asp-action="Index" asp-all-route-data="fullTransactionRouteData"
       style="cursor:pointer">
        <span>Transactions</span>
        <i class="bi bi-card-list"></i>
    </a>
    <a id="planBudgetButton"
       class="text-decoration-none py-1 px-4 rounded-pill d-flex gap-2 btn-outline-success border border-success"
       asp-controller="Plan" asp-action="Index" asp-all-route-data="fullTransactionRouteData" style="cursor:pointer">
        <span>Plan</span>
        <i class="bi bi-card-checklist"></i>
    </a>
    <a id="savingsGoalsButton"
       class="text-decoration-none py-1 px-4 rounded-pill d-flex gap-2 btn-outline-success border border-success"
       asp-controller="SavingsGoals" asp-action="Index" asp-all-route-data="fullTransactionRouteData"
       style="cursor:pointer">
        <span>Savings Goals</span>
        <i class="bi bi-piggy-bank"></i>
    </a>
</div>

