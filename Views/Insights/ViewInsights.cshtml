        }
    }
</script>


<script>
    const currencyFormatter = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });

    let expensesCategories =  @Html.Raw(JsonConvert.SerializeObject(expensesByCategory));
    let incomeCategories =  @Html.Raw(JsonConvert.SerializeObject(incomeByCategory));
    let transactionsByDate =  @Html.Raw(JsonConvert.SerializeObject(transactionsByDate));
    //savings
    let addToSavingsCategories =  @Html.Raw(JsonConvert.SerializeObject(addToSavingsByCategory));
    let withdrawFromSavingsCategories =  @Html.Raw(JsonConvert.SerializeObject(withdrawFromSavingsByCategory));
    let savingsContributionsByDate =  @Html.Raw(JsonConvert.SerializeObject(savingsContributionsByDate));
    console.log(savingsContributionsByDate)
    //expense categories
    var transactionCategoriesCtx = document.getElementById('donutTransactionCategoriesChart').getContext('2d');
    var expenseChart = new Chart(transactionCategoriesCtx, {
        type: 'doughnut',
        data: {
            labels: expensesCategories.map(cat => cat.CategoryName),
            datasets: [{
                label: 'Expenses',
                backgroundColor: expensesCategories.map(cat => cat.CategoryColor),
                //borderColor: 'rgb(255, 99, 132)',
                data: expensesCategories.map(cat => cat.Amount)
            }]
        },
        options: {
            legend: {
                display: expensesCategories?.length <= 10,
                responsive: true,
                position: 'bottom',
                labels: {
                    usePointStyle: true,
                }
            },
            tooltips: {
                callbacks: {
                    label: function (tooltipItem, data) {
                        let amount = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        amount = currencyFormatter.format(amount)
                        let label = data.labels[tooltipItem.index];
                        return `${label}: ${amount}`;
                    }
                }
            }
        }
    });

    //income categories
    var incomeCategoriesCtx = document.getElementById('donutIncomeCategoriesChart').getContext('2d');
    var incomeChart = new Chart(incomeCategoriesCtx, {
        type: 'doughnut',
        data: {
            labels: incomeCategories.map(cat => cat.CategoryName),
            datasets: [{
                label: 'Income',
                backgroundColor: incomeCategories.map(cat => cat.CategoryColor),
                //borderColor: 'rgb(255, 99, 132)',
                data: incomeCategories.map(cat => cat.Amount)
            }]
        },
        options: {
            legend: {
                display: incomeCategories?.length <= 10,
                responsive: true,
                position: 'bottom',
                labels: {
                    usePointStyle: true,
                }
            },
            tooltips: {
                callbacks: {
                    label: function (tooltipItem, data) {
                        let amount = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        amount = currencyFormatter.format(amount)
                        let label = data.labels[tooltipItem.index];
                        return `${label}: ${amount}`;
                    }
                }
            }
        }
    });

    //budget expense/income bar chart 
    var incomeExpenseBarChartCtx = document.getElementById('incomeExpenseBarChart').getContext('2d');
    var incomeExpenseBarChart = new Chart(incomeExpenseBarChartCtx, {
        type: 'bar',
        data: {
            labels: ['Income', 'Expense', 'Balance'],
            datasets: [{
                label: 'Income',
                backgroundColor: ['#4BB543', '#FF0000', '#0d6efd'],
                data: [@incomeAmount, @expenseAmount, @balance]
            }]
        },
        options: {
            legend: {
                display: false,
                responsive: true,
                position: 'bottom'
            },
            tooltips: {
                callbacks: {
                    label: function (tooltipItem, data) {
                        let amount = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        amount = currencyFormatter.format(amount)
                        let label = data.labels[tooltipItem.index];
                        return `${label}: ${amount}`;
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    min: 0,
                },
            }
        },

    });

    //transactions by date line chart 
    var itransactionsByDateLineChartCtx = document.getElementById('transactionsByDateLineChart').getContext('2d');
    var transactionsByDateLineChart = new Chart(itransactionsByDateLineChartCtx, {
        type: 'line',
        data: {
            labels: transactionsByDate.map(transaction => new Date(transaction.TransactionDate).toLocaleDateString('en-us', { month: "short", day: "numeric" })),
            datasets: [{
                label: 'Income',
                borderColor: 'rgb(75, 192, 192)',
                backgroundColor: '#0d6efd',
                data: transactionsByDate.map(transaction => transaction.Amount),
                fill: false,
                pointRadius: 7, //make points larger (default is 1)

            }]
        },
        options: {
            legend: {
                display: false,
                responsive: true,
                position: 'bottom'
            },
            tooltips: {
                callbacks: {
                    label: function (tooltipItem, data) {
                        let amount = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        amount = currencyFormatter.format(amount)
                        let label = data.labels[tooltipItem.index];
                        return `${label}: ${amount}`;
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    min: 0,
                    ticks: {
                        callback: function (value, index, ticks) {
                            return '$' + value;
                        }
                    },
                },
            }
        },

    });


    // add to savings chart
    var addToSavingsCategoriesCtx = document.getElementById('donutTransactionAddToSavingsChart').getContext('2d');
    var addToSavingsChart = new Chart(addToSavingsCategoriesCtx, {
        type: 'doughnut',
        data: {
            labels: addToSavingsCategories.map(cat => cat.SavingsGoalTitle),
            datasets: [{
                label: 'Expenses',
                backgroundColor: addToSavingsCategories.map(cat => cat.SavingsGoalColor),
                //borderColor: 'rgb(255, 99, 132)',
                data: addToSavingsCategories.map(cat => cat.Amount)
            }]
        },
        options: {
            legend: {
                display: addToSavingsCategories?.length <= 10,
                responsive: true,
                position: 'bottom',
                labels: {
                    usePointStyle: true,
                }
            },
            tooltips: {
                callbacks: {
                    label: function (tooltipItem, data) {
                        let amount = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        amount = currencyFormatter.format(amount)
                        let label = data.labels[tooltipItem.index];
                        return `${label}: ${amount}`;
                    }
                }
            }
        }
    });

    // withdraw from savings chart
    var withdrawFromSavingsCategoriesCtx = document.getElementById('donutTransactionWithdrawFromSavingsChart').getContext('2d');
    var withdrawFromSavingsChart = new Chart(withdrawFromSavingsCategoriesCtx, {
        type: 'doughnut',
        data: {
            labels: withdrawFromSavingsCategories.map(cat => cat.SavingsGoalTitle),
            datasets: [{
                label: 'Expenses',
                backgroundColor: withdrawFromSavingsCategories.map(cat => cat.SavingsGoalColor),
                //borderColor: 'rgb(255, 99, 132)',
                data: withdrawFromSavingsCategories.map(cat => cat.Amount)
            }]
        },
        options: {
            legend: {
                display: withdrawFromSavingsCategories?.length <= 10,
                responsive: true,
                position: 'bottom',
                labels: {
                    usePointStyle: true,
                }
            },
            tooltips: {
                callbacks: {
                    label: function (tooltipItem, data) {
                        let amount = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        amount = currencyFormatter.format(amount)
                        let label = data.labels[tooltipItem.index];
                        return `${label}: ${amount}`;
                    }
                }
            }
        }
    });

    //savings contributions by date line chart 
    var isavingsContributionsByDateLineChartCtx = document.getElementById('savingsContributionsByDateLineChart').getContext('2d');
    var savingsContributionsByDateLineChart = new Chart(isavingsContributionsByDateLineChartCtx, {
        type: 'line',
        data: {
            labels: savingsContributionsByDate.map(transaction => new Date(transaction.TransactionDate).toLocaleDateString('en-us', { month: "short", day: "numeric" })),
            datasets: [{
                label: 'Income',
                borderColor: 'rgb(75, 192, 192)',
                backgroundColor: '#0d6efd',
                data: savingsContributionsByDate.map(transaction => transaction.Amount),
                fill: false,
                pointRadius: 7, //make points larger (default is 1)

            }]
        },
        options: {
            legend: {
                display: false,
                responsive: true,
                position: 'bottom'
            },
            tooltips: {
                callbacks: {
                    label: function (tooltipItem, data) {
                        let amount = data.datasets[tooltipItem.datasetIndex].data[tooltipItem.index];
                        amount = currencyFormatter.format(amount)
                        let label = data.labels[tooltipItem.index];
                        return `${label}: ${amount}`;
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    min: 0,
                    ticks: {
                        callback: function (value, index, ticks) {
                            return '$' + value;
                        }
                    },
                },
            }
        },

    });



</script>

<script>
    const nextMonth = () => {
        location.href = "@Url.Action("Index", "Insights")" + `?budgetID=${"@(budgetID.ToString())"}&year=${@(nextYear)}&month=${@(nextMonth)}`;
    }
    const previousMonth = () => {
        location.href = "@Url.Action("Index", "Insights")" + `?budgetID=${"@(budgetID.ToString())"}&year=${@(previousYear)}&month=${@(previousMonth)}`;
    }
</script>