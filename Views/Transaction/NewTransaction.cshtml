@using TropicalBudget.Models.ViewModels
@using TropicalBudget.Utilities
@model NewTransactionViewModel
@{
    ViewData["Title"] = "New Transaction";
    List<TransactionCategory> transactionCategories = Model.TransactionCategories;
    List<TransactionSource> transactionSources = Model.TransactionSources;
    List<TransactionType> transactionTypes = Model.TransactionTypes;
    List<SavingsGoal> savingsGoals = Model.SavingsGoals;
    
    Dictionary<string, string> newTransactionRouteData = new()
    {
        {"budgetID", Model.NewTransaction.BudgetID.ToString()}
    };
}

<div class="text-center">
    <h1 class="display-4">New Transaction</h1>
    <div>
        @using (Html.BeginForm("AddNewTransaction", "Transaction"))
        {
            @Html.AntiForgeryToken();
            <div class="d-flex flex-column gap-2">
                @Html.HiddenFor(x => x.NewTransaction.BudgetID)
                @Html.LabelFor(x =>x.NewTransaction.Amount)
                <div class="input-group mb-3">
                    <div class="input-group-prepend">
                        <span class="input-group-text">$</span>
                    </div>
                    @Html.TextBoxFor(x => x.NewTransaction.Amount, new { @placeholder = "Amount", @type = "number", @min = 0, @class = "form-control", @step = "0.01", @required = true })
                </div>
                
                @* @Html.LabelFor(x => x.TransactionTypeID, "Transaction Type")
                @Html.DropDownListFor(x => x.TransactionTypeID, new SelectList(transactionTypes, "ID", "Name"),"-- Select Transaction Type --", new { @class = "form-select", @onchange = "onTransactionTypeChanged(this.options[this.selectedIndex].text)", @required = true }) *@
                @Html.LabelFor(x => x.NewTransaction.UiTransactionType, "Transaction Type")
                @Html.DropDownListFor(x => x.NewTransaction.UiTransactionType, new List<SelectListItem>(){
                    new SelectListItem {Value = "expense", Text = "Expense"},
                    new SelectListItem {Value = "income", Text = "Income"},
                    new SelectListItem {Value = "add_savings", Text = "Add to Savings"},
                    new SelectListItem {Value = "withdraw_savings", Text = "Withdraw from Savings"},
                    
                    }, new { @class = "form-select", @onchange = "onTransactionTypeChanged(this.options[this.selectedIndex].text)", @required = true })

                <div id="category-section" class="d-flex flex-column gap-2">
                    @if (transactionCategories == null || transactionCategories.Count <= 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            No categories available. Please <a asp-controller="Category" asp-action="Index">add a category</a> first.
                        </div>
                    }
                    @Html.LabelFor(x =>x.NewTransaction.CategoryID, "Category")
                    <div class="d-flex align-items-center gap-2">
                        @Html.DropDownListFor(x => x.NewTransaction.CategoryID, new SelectList(transactionCategories, "ID", "Name"), new { @class = "form-select", @id="category-dropdown" })
                        <a asp-controller="Category" asp-action="Index">
                            <i style="cursor:pointer" class="bi bi-pencil-fill text-white px-3 py-2 fs-6 bg-primary rounded"></i>
                        </a>
                    </div>
                </div>
                <div id="savings-goal-section" class="d-none flex-column gap-2">
                   @if (savingsGoals == null || savingsGoals.Count <= 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            No savings goals set. Please <a asp-controller="SavingsGoals" asp-action="Index" asp-all-route-data="newTransactionRouteData">set a goal</a> first.
                        </div>
                    }
                    @Html.LabelFor(x =>x.NewTransaction.SavingsGoalID, "Savings Goal")
                    <div class="d-flex align-items-center gap-2">
                        @Html.DropDownListFor(x => x.NewTransaction.SavingsGoalID, new SelectList(savingsGoals, "ID", "Title"), new { @class = "form-select", @id="savings-goal-dropdown" })
                        <a asp-controller="SavingsGoals" asp-action="Index" asp-all-route-data="newTransactionRouteData">
                            <i style="cursor:pointer" class="bi bi-pencil-fill text-white px-3 py-2 fs-6 bg-primary rounded"></i>
                        </a>
                    </div>
                </div>
                @if (transactionSources == null || transactionSources.Count <= 0)
                {
                    <div class="alert alert-danger" role="alert">
                        No sources available. Please <a asp-controller="Sources" asp-action="Index">add a source</a> first.
                    </div>
                }
                @Html.LabelFor(x =>x.NewTransaction.SourceID, "From", new{ @id ="source-label"})
                <div class="d-flex align-items-center gap-2">
                    @Html.DropDownListFor(x => x.NewTransaction.SourceID, new SelectList(transactionSources, "ID", "Name"), new { @class = "form-select", @required = true })
                    <a asp-controller="Sources" asp-action="Index">
                        <i style="cursor:pointer" class="bi bi-pencil-fill text-white px-3 py-2 fs-6 bg-primary rounded"></i>
                    </a>
                </div>
               
                @Html.LabelFor(x => x.NewTransaction.TransactionDate, "Date")
                @Html.TextBoxFor(x => x.NewTransaction.TransactionDate, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control", @required = true })
                @Html.LabelFor(x => x.NewTransaction.Note)
                @Html.TextBoxFor(x => x.NewTransaction.Note, new { @placeholder = "Note", @type = "text", @class = "form-control" })

                <input type="submit" name="SaveButton" class="btn btn-primary" value="Save" />
                <input type="button" name="ExitButton" onclick="navigateToHome()" class="btn btn-outline-primary" value="Exit" />

            </div>
        }
    </div>
</div>

<script>
    const navigateToHome = () =>{
        location.href = "@Url.Action("Index", "Transaction")" +"?budgetID=@(Model.NewTransaction.BudgetID.ToString())";
    }
    const hideCategorySection = () => {

    }

    const showCategorySection = () => {

    }

    const hideSavingsGoalSection = () => {
        
    }
    const showSavingsGoalSection = () => {

    }
    const onTransactionTypeChanged = (transactionType) =>  {
        const source_label = document.getElementById('source-label');
        const category_section = document.getElementById('category-section');
        const savings_goal_section = document.getElementById('savings-goal-section');
        const categoryDropdown = document.getElementById('category-dropdown');
        const savingsGoalDropdown = document.getElementById('savings-goal-dropdown');

        if(transactionType == "@TransactionUtility.TRANSACTION_TYPE_EXPENSE"){
            source_label.innerText = "From";
            category_section.classList.add("d-flex")
            category_section.classList.remove("d-none")
            savings_goal_section.classList.add("d-none")
            savings_goal_section.classList.remove("d-flex")
            categoryDropdown.required = true;
            savingsGoalDropdown.required = false;
        }else if(transactionType == "@TransactionUtility.TRANSACTION_TYPE_INCOME"){
            source_label.innerText = "To";
            category_section.classList.add("d-flex")
            category_section.classList.remove("d-none")
            savings_goal_section.classList.add("d-none")
            savings_goal_section.classList.remove("d-flex")
            categoryDropdown.required = true;
            savingsGoalDropdown.required = false;
        }else if(transactionType == "@TransactionUtility.TRANSACTION_TYPE_SAVINGS_ADD"){
            source_label.innerText = "From";
            category_section.classList.add("d-none")
            category_section.classList.remove("d-flex")
            savings_goal_section.classList.add("d-flex")
            savings_goal_section.classList.remove("d-none")
            categoryDropdown.required = false;
            savingsGoalDropdown.required = true;
        }else if(transactionType == "@TransactionUtility.TRANSACTION_TYPE_SAVINGS_WITHDRAW"){
            source_label.innerText = "To";
            category_section.classList.add("d-none")
            category_section.classList.remove("d-flex")
            savings_goal_section.classList.add("d-flex")
            savings_goal_section.classList.remove("d-none")
            categoryDropdown.required = false;
            savingsGoalDropdown.required = true;
        }
    }
</script>